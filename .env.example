PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swiftcare
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=true
JWT_SECRET=change-me-in-real-life
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5500,https://swiftcare-eight.vercel.app
# Base URL for links embedded in emails (currently just the invite link).
FRONTEND_URL=http://localhost:5173

# Invite email delivery, via SendGrid's HTTPS Web API (D20 — originally SMTP,
# switched off SMTP because PaaS hosts like Railway block that outbound port).
# EMAIL_FROM must be a sender verified in SendGrid.
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=no-reply@your-verified-domain.example
