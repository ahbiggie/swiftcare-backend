PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swiftcare
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=true
JWT_SECRET=change-me-in-real-life
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://swiftcare-eight.vercel.app
# Base URL for links embedded in emails (currently just the invite link).
FRONTEND_URL=http://localhost:5173

# Invite email delivery, via Nodemailer over SendGrid's SMTP relay (D20).
# EMAIL_FROM must be a sender verified in SendGrid, and SENDGRID_API_KEY is
# the real credential — the SMTP username itself is always the literal string
# "apikey", hardcoded in src/utils/email.js, not configured here.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=no-reply@your-verified-domain.example
